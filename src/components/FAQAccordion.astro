---
import faqData from '../data/faq-100.json';

const categories = Array.from(new Set(faqData.map(item => item.cluster)));
---

<div class="space-y-6">
  <!-- Controls: Search & Category Filter Tabs -->
  <div class="space-y-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
    <div class="relative">
      <input
        type="text"
        id="faq-search-input"
        placeholder="搜索 100 个 FAQ 问题（如：Clash报错、小火箭超时、ChatGPT、选购技巧）..."
        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
      />
    </div>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-2 text-xs font-medium" id="category-pills">
      <button
        data-cat="all"
        class="faq-cat-btn px-3 py-1.5 rounded-lg bg-blue-600 text-white font-bold transition-colors"
      >
        全部 100 问 (100)
      </button>
      {categories.map(cat => {
        const count = faqData.filter(f => f.cluster === cat).length;
        return (
          <button
            data-cat={cat}
            class="faq-cat-btn px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors"
          >
            {cat} ({count})
          </button>
        );
      })}
    </div>
  </div>

  <!-- FAQ Accordion List -->
  <div id="faq-list-container" class="space-y-3">
    {faqData.map((item, idx) => (
      <details
        id={item.slug}
        data-category={item.cluster}
        data-text={`${item.question} ${item.answer} ${item.keywords.join(' ')}`}
        class="faq-item group bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden transition-all shadow-sm"
      >
        <summary class="px-6 py-4 cursor-pointer flex items-center justify-between font-bold text-slate-900 dark:text-white text-base select-none hover:bg-slate-50 dark:hover:bg-slate-700/50">
          <div class="flex items-center gap-3 pr-4">
            <span class="px-2.5 py-0.5 text-xs font-mono font-bold bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded">
              #{item.id}
            </span>
            <span>{item.question}</span>
          </div>
          <span class="text-slate-400 group-open:rotate-180 transition-transform text-lg">
            ▼
          </span>
        </summary>
        <div class="px-6 pb-6 pt-2 text-sm text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-slate-700/50 leading-relaxed bg-slate-50/50 dark:bg-slate-900/30">
          <div class="mb-3 font-normal">{item.answer}</div>
          <div class="flex items-center justify-between text-xs text-slate-400 pt-2 border-t border-slate-200/40 dark:border-slate-700/40">
            <span>主题：{item.cluster}</span>
            <span>核验日期：{item.lastChecked}</span>
          </div>
        </div>
      </details>
    ))}
  </div>
</div>

<script is:inline>
  const searchInput = document.getElementById('faq-search-input');
  const catBtns = document.querySelectorAll('.faq-cat-btn');
  const items = document.querySelectorAll('.faq-item');

  let activeCat = 'all';
  let activeQuery = '';

  function filterFAQ() {
    items.forEach(item => {
      const itemCat = item.getAttribute('data-category');
      const itemText = item.getAttribute('data-text').toLowerCase();

      const matchesCat = activeCat === 'all' || itemCat === activeCat;
      const matchesQuery = !activeQuery || itemText.includes(activeQuery);

      if (matchesCat && matchesQuery) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      catBtns.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'font-bold');
        b.classList.add('bg-slate-100', 'dark:bg-slate-700', 'text-slate-700', 'dark:text-slate-200');
      });
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-700', 'text-slate-700', 'dark:text-slate-200');
      btn.classList.add('bg-blue-600', 'text-white', 'font-bold');

      activeCat = btn.getAttribute('data-cat');
      filterFAQ();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    activeQuery = e.target.value.trim().toLowerCase();
    filterFAQ();
  });
</script>
