---
interface Props {
  items: { label: string; url?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 px-4 bg-slate-100/60 dark:bg-slate-800/40 rounded-xl mb-6 text-xs text-slate-500 dark:text-slate-400">
  <ol class="flex items-center flex-wrap gap-2">
    <li>
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">首页</a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <span class="text-slate-300 dark:text-slate-600">/</span>
        {item.url && index < items.length - 1 ? (
          <a href={item.url} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{item.label}</a>
        ) : (
          <span class="text-slate-800 dark:text-slate-200 font-bold truncate max-w-[200px] sm:max-w-xs">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
