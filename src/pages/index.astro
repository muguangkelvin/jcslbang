---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProviderCard from '../components/ProviderCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import AirportGuideFeatured from '../components/AirportGuideFeatured.astro';
import providersData from '../data/providers.json';

import { getCollection } from 'astro:content';

const primaryProviders = providersData.filter(p => p.isPrimary);
const otherProviders = providersData.filter(p => !p.isPrimary);

const ranksArticles = (await getCollection('ranks')).slice(0, 6);
const guidesArticles = (await getCollection('guides')).slice(0, 6);
const clientsArticles = (await getCollection('clients')).slice(0, 6);
---

<BaseLayout>
  <!-- Hero Section -->
  <Hero />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Primary Top 4 Providers Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white flex items-center gap-2">
            <span>🏆</span>
            <span>2026 机场实力榜 · 首选 4 大精选自营服务</span>
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            经过全天候晚高峰延迟测速与流媒体解锁测试，严格保持灵动云第一、暮光网络第二、飞猫云第三、微风网络第四固定展示。
          </p>
        </div>
        <a href="/providers" class="hidden sm:inline-flex items-center text-sm font-bold text-blue-600 dark:text-blue-400 hover:underline">
          查看全部 28 家机场 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {primaryProviders.map(p => (
          <ProviderCard
            rank={p.rank}
            name={p.name}
            slug={p.slug}
            inviteURL={p.inviteURL}
            priceFrom={p.priceFrom}
            trafficFrom={p.trafficFrom}
            coupon={p.coupon}
            suitableFor={p.suitableFor}
            summary={p.summary}
            isPrimary={true}
            regions={p.regions}
            aiUnlock={p.aiUnlock}
            deviceLimit={p.deviceLimit}
            packagesSummary={p.packagesSummary}
          />
        ))}
      </div>
    </section>

    <!-- Featured Beginner Airport Selection & Setup Guide -->
    <AirportGuideFeatured />

    <!-- Quick Navigation Modules -->
    <section class="space-y-6">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white">
          🧭 全站核心导航分类与精选文章
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          专为零基础小白用户打造，从科学上网入门、客户端配置到 IPLC 专线测评全覆盖。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 实力榜单 -->
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📊</span> 实力榜单 (/ranks)
            </h3>
            <span class="text-xs px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 font-bold">15 篇精选</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            涵盖 2026 最新测速排行榜、月付便宜机场实力榜、IPLC 专线与流媒体解锁榜。
          </p>
          <ul class="space-y-2 text-xs">
            {ranksArticles.map(a => (
              <li>
                <a href={`/ranks/${a.id}`} class="text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 line-clamp-1">
                  • {a.data.title}
                </a>
              </li>
            ))}
          </ul>
          <a href="/ranks" class="block text-center py-2 bg-slate-100 dark:bg-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-200">
            浏览全部 15 篇实力榜单文章 →
          </a>
        </div>

        <!-- 新手入门 -->
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔰</span> 新手入门 (/guides)
            </h3>
            <span class="text-xs px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 font-bold">20 篇教程</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            从零基础了解梯子概念、买机场防踩坑法则到订阅链接导入全流程。
          </p>
          <ul class="space-y-2 text-xs">
            {guidesArticles.map(a => (
              <li>
                <a href={`/guides/${a.id}`} class="text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 line-clamp-1">
                  • {a.data.title}
                </a>
              </li>
            ))}
          </ul>
          <a href="/guides" class="block text-center py-2 bg-slate-100 dark:bg-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-200">
            浏览全部 20 篇新手入门教程 →
          </a>
        </div>

        <!-- 客户端教程 -->
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>💻</span> 客户端教程 (/clients)
            </h3>
            <span class="text-xs px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300 font-bold">25 篇教学</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Clash Verge Rev、Shadowrocket (小火箭)、Sing-box 及 v2rayN 图文图解教程。
          </p>
          <ul class="space-y-2 text-xs">
            {clientsArticles.map(a => (
              <li>
                <a href={`/clients/${a.id}`} class="text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 line-clamp-1">
                  • {a.data.title}
                </a>
              </li>
            ))}
          </ul>
          <a href="/clients" class="block text-center py-2 bg-slate-100 dark:bg-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-200">
            浏览全部 25 篇客户端教程 →
          </a>
        </div>
      </div>
    </section>

    <!-- Master Provider Comparison Table -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4">
        <div>
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">
            📋 全网 28 家机场价格与节点横向对比表
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            一表全览 28 家机场的价格、流量配置、适用场景与官方注册入口。
          </p>
        </div>
        <a href="/providers/all-28-airports-complete-guide-and-links" class="text-sm font-bold text-blue-600 dark:text-blue-400 hover:underline">
          查看 28 家机场汇总文章 →
        </a>
      </div>

      <div class="overflow-x-auto bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <table class="w-full min-w-[700px] text-sm text-left text-slate-700 dark:text-slate-200 border-collapse">
          <thead class="bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-white font-bold whitespace-nowrap">
            <tr>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 text-center whitespace-nowrap">排名</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">机场名称</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">参考价格</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">流量配置</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">优惠码</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 min-w-[180px]">适用场景</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700 text-center whitespace-nowrap">官网注册</th>
            </tr>
          </thead>
          <tbody>
            {providersData.slice(0, 10).map(p => (
              <tr class="border-b border-slate-100 dark:border-slate-700/50 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                <td class="p-3 font-bold text-slate-900 dark:text-white text-center whitespace-nowrap">#{p.rank}</td>
                <td class="p-3 font-bold text-blue-600 dark:text-blue-400 whitespace-nowrap">
                  <a href={`/providers/${p.slug}`} class="hover:underline">{p.name}</a>
                </td>
                <td class="p-3 whitespace-nowrap font-medium">{p.priceFrom}</td>
                <td class="p-3 whitespace-nowrap font-medium">{p.trafficFrom}</td>
                <td class="p-3 font-mono text-xs text-blue-600 dark:text-blue-400 whitespace-nowrap">{p.coupon || '暂无'}</td>
                <td class="p-3 text-xs text-slate-500 dark:text-slate-400 max-w-xs truncate">{p.suitableFor}</td>
                <td class="p-3 text-center whitespace-nowrap">
                  <a
                    href={p.inviteURL}
                    target="_blank"
                    rel="sponsored nofollow noopener"
                    class="inline-block px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm whitespace-nowrap"
                  >
                    前往官网
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="text-center pt-2">
        <a href="/providers" class="inline-flex items-center px-6 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold rounded-xl hover:bg-slate-200 text-sm">
          查看剩余 18 家机场完整对比表 →
        </a>
      </div>
    </section>

    <!-- FAQ 100 Section -->
    <section class="space-y-6">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>❓</span>
          <span>避坑答疑 · 100 个常见 FAQ 问题交互检索中心</span>
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          AI 智能生成 100 个不重复的长尾问题与答案，涵盖客户端报错排查、专线区别、流媒体解锁与安全隐私。
        </p>
      </div>

      <FAQAccordion />
    </section>
  </div>
</BaseLayout>
