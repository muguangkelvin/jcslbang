---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('faq');
---

<BaseLayout title="避坑答疑 - 机场实力榜 | jcslbang.homes" description="机场常见问题排查、订阅更新失败解决、节点超时与选购避坑总结。包含 25 篇专题解答。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[{ label: '避坑答疑' }]} />

    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <h1 class="text-3xl font-black text-slate-900 dark:text-white flex items-center gap-2">
        <span>📁</span>
        <span>避坑答疑</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm">
        机场常见问题排查、订阅更新失败解决、节点超时与选购避坑总结。包含 25 篇专题解答。
      </p>
    </div>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map(a => (
        <ArticleCard post={a} categorySlug="faq" defaultCategoryLabel="避坑答疑" />
      ))}
    </div>
  </div>
</BaseLayout>
