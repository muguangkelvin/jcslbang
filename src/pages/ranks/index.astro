---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('ranks');
---

<BaseLayout title="实力榜单 - 机场实力榜 | jcslbang.homes" description="2026机场实力榜、测速排行榜与稳定梯子推荐。包含 15 篇深度跑分测速文章。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[{ label: '实力榜单' }]} />

    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <h1 class="text-3xl font-black text-slate-900 dark:text-white flex items-center gap-2">
        <span>📁</span>
        <span>实力榜单</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm">
        2026机场实力榜、测速排行榜与稳定梯子推荐。包含 15 篇深度跑分测速文章。
      </p>
    </div>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map(a => (
        <ArticleCard post={a} categorySlug="ranks" defaultCategoryLabel="实力榜单" />
      ))}
    </div>
  </div>
</BaseLayout>
