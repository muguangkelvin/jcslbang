---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import providersData from '../../data/providers.json';

const primaryFour = providersData.slice(0, 4);
---

<BaseLayout
  title="2026年全网28家精选机场官网注册链接、价格节点与解锁AI资料全汇总 | jcslbang.homes"
  description="一站式收集全网28家精选梯子机场的官网注册链接、最新价格、套餐流量、节点地区、协议支持及解锁ChatGPT/Netflix资料汇总。"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[{ label: '机场合集', url: '/providers' }, { label: '28家机场资料全汇总' }]} />

    <article class="bg-white dark:bg-slate-900 p-6 sm:p-10 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-8">
      <!-- Header -->
      <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-4">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 text-xs font-bold bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded-lg">
            机场测评全汇总
          </span>
          <span class="text-xs text-slate-400">核验时间：2026-09-20</span>
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white leading-tight">
          2026年全网 28 家精选机场官网注册链接与资料全汇总
        </h1>
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
          💡 <strong>测评说明</strong>：本页面包含了 <strong>机场实力榜</strong> 评测池中全部 28 家机场的完整资料，包括官网注册链接、优惠码、套餐价格、节点情况及 AI 解锁能力。建议收藏本页以便随时查阅！
        </p>
      </header>

      <!-- Top 4 Primary Providers - Clean Side-by-Side 2x2 Grid -->
      <section class="p-6 bg-gradient-to-br from-blue-50/70 to-indigo-50/70 dark:from-slate-800/80 dark:to-slate-900/80 rounded-2xl border border-blue-200 dark:border-slate-700 shadow-sm space-y-6">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-blue-600">🏆</span> 2026 机场实力榜 · 4大首选自营与高稳定服务推荐
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            经过编辑部真实网络多时段测速与晚高峰压力测试，以下 4 家机场在连通率、节点速度、4K画质播放与客服响应上表现最为卓越，严格保持灵动云第一、暮光网络第二、飞猫云第三、微风网络第四展示：
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card #1 灵动云 -->
          <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2.5 py-1 text-xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-200 rounded-full border border-amber-200 dark:border-amber-800">
                  🥇 第一名 · 实力总冠军
                </span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  20元/月 120GB起
                </span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between">
                  <span>灵动云 (LingDong Cloud)</span>
                  <span class="text-xs font-mono px-2 py-0.5 bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 rounded border border-blue-200 dark:border-blue-800">
                    码: ld888
                  </span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                  全节点智能分流，多出口原生IP，全端解锁 AI 与流媒体，晚高峰4K秒开不卡顿。
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60">
              <a href="/providers/lingdong-cloud" class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-lg transition-colors">
                查看测评
              </a>
              <a href="https://varnexa.lingdongaff.com/#/?code=vFPRdc1J" target="_blank" rel="sponsored nofollow noopener" class="flex-1 text-center px-3 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors">
                前往官网注册 (折扣码 ld888)
              </a>
            </div>
          </div>

          <!-- Card #2 暮光网络 -->
          <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2.5 py-1 text-xs font-bold bg-slate-200 text-slate-800 dark:bg-slate-700 dark:text-slate-200 rounded-full border border-slate-300 dark:border-slate-600">
                  🥈 第二名 · 影音流媒体推荐
                </span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  20元/月 120GB
                </span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between">
                  <span>暮光网络 (Twilight)</span>
                  <span class="text-xs font-mono px-2 py-0.5 bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 rounded border border-blue-200 dark:border-blue-800">
                    码: mm88
                  </span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                  原生 IP 全解 Netflix/Disney+/TikTok，大流量与多设备并行，晚高峰看推特油管顺畅。
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60">
              <a href="/providers/twilight" class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-lg transition-colors">
                查看测评
              </a>
              <a href="https://varnexa.twilightaff.com/#/?code=X6iVG1Zb" target="_blank" rel="sponsored nofollow noopener" class="flex-1 text-center px-3 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors">
                前往官网注册 (折扣码 mm88)
              </a>
            </div>
          </div>

          <!-- Card #3 飞猫云 -->
          <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2.5 py-1 text-xs font-bold bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300 rounded-full border border-amber-200 dark:border-amber-800">
                  🥉 第三名 · 性价比之王
                </span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  折合 7元/月起
                </span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between">
                  <span>飞猫云 (FlyCat Cloud)</span>
                  <span class="text-xs font-mono px-2 py-0.5 bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 rounded border border-blue-200 dark:border-blue-800">
                    码: flycat888
                  </span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                  极致便宜稳定，小流量年付仅84元，IEPL专线节点，新手入门零压力保姆配置。
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60">
              <a href="/providers/flycat-cloud" class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-lg transition-colors">
                查看测评
              </a>
              <a href="https://flycat1.flycatvipaff.cc/#/?code=KRjsCIZV" target="_blank" rel="sponsored nofollow noopener" class="flex-1 text-center px-3 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors">
                前往官网注册 (折扣码 flycat888)
              </a>
            </div>
          </div>

          <!-- Card #4 微风网络 -->
          <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2.5 py-1 text-xs font-bold bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300 rounded-full border border-slate-200 dark:border-slate-600">
                  🏅 第四名 · 稳定代步老牌
                </span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  以结算页为准
                </span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between">
                  <span>微风网络 (Breezenet)</span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                  老牌稳健中转，极简订阅导入，适合日常网页访问与多设备代步需求。
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60">
              <a href="/providers/breezenet" class="px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-lg transition-colors">
                查看测评
              </a>
              <a href="https://edp01.breezenetaff.com/#/?code=txKNNHZc" target="_blank" rel="sponsored nofollow noopener" class="flex-1 text-center px-3 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors">
                前往官网注册入口
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Master Table of 28 Providers -->
      <section class="space-y-4">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
          <span>📋</span> 28 家机场完整资料与注册入口清单
        </h2>

        <div class="overflow-x-auto border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm">
          <table class="w-full min-w-[700px] text-sm text-left text-slate-700 dark:text-slate-200 border-collapse">
            <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold whitespace-nowrap">
              <tr>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 text-center whitespace-nowrap">排名</th>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">机场名称</th>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">参考价格</th>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">流量配置</th>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap">优惠码</th>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 min-w-[180px]">适用场景</th>
                <th class="p-3 border-b border-slate-200 dark:border-slate-700 text-center whitespace-nowrap">官网注册</th>
              </tr>
            </thead>
            <tbody>
              {providersData.map(p => (
                <tr class="border-b border-slate-100 dark:border-slate-700/50 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                  <td class="p-3 font-bold text-slate-900 dark:text-white text-center whitespace-nowrap">#{p.rank}</td>
                  <td class="p-3 font-bold text-blue-600 dark:text-blue-400 whitespace-nowrap">
                    <a href={`/providers/${p.slug}`} class="hover:underline">{p.name}</a>
                  </td>
                  <td class="p-3 whitespace-nowrap font-medium">{p.priceFrom}</td>
                  <td class="p-3 whitespace-nowrap font-medium">{p.trafficFrom}</td>
                  <td class="p-3 font-mono text-xs text-blue-600 dark:text-blue-400 whitespace-nowrap">{p.coupon || '暂无'}</td>
                  <td class="p-3 text-xs text-slate-500 dark:text-slate-400 max-w-xs truncate">{p.suitableFor}</td>
                  <td class="p-3 text-center whitespace-nowrap">
                    <a
                      href={p.inviteURL}
                      target="_blank"
                      rel="sponsored nofollow noopener"
                      class="inline-block px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm whitespace-nowrap"
                    >
                      前往官网
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Detailed Provider Overviews -->
      <section class="space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white">
          📝 全网 28 家机场独立简介与评测要点
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {providersData.map(p => (
            <div class="p-4 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200/80 dark:border-slate-700/80 space-y-2">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-slate-900 dark:text-white text-base">
                  #{p.rank} {p.name}
                </h3>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">{p.priceFrom}</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {p.summary}
              </p>
              <div class="flex items-center justify-between pt-2 text-xs">
                <span class="text-slate-400">适用：{p.suitableFor}</span>
                <a href={`/providers/${p.slug}`} class="text-blue-600 dark:text-blue-400 font-bold hover:underline">
                  查看测评 →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
