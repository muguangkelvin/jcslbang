---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import providersData from '../../data/providers.json';
---

<BaseLayout
  title="28家机场合集 - 全网精选梯子价格、节点与官网注册全汇总 | jcslbang.homes"
  description="全网28家精选梯子机场合集目录。汇总提供包含全球云、飞猫云、暮光网络在内的各家价格、流量配置、原生IP与官网注册链接。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[{ label: '机场合集' }]} />

    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <h1 class="text-3xl font-black text-slate-900 dark:text-white flex items-center gap-2">
        <span>🌐</span>
        <span>全网 28 家精选机场全汇总目录</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm">
        包含全套餐价格对比、解锁热点、覆盖地区、设备限制及优化简介，文字排版严格并列对齐。
      </p>
    </div>

    <!-- Master Summary Link Banner (100% Clickable Block Container) -->
    <a
      href="/providers/all-28-airports-complete-guide-and-links"
      class="group block p-5 sm:p-6 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 rounded-2xl text-white shadow-lg hover:shadow-xl hover:scale-[1.005] transition-all cursor-pointer"
    >
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-bold text-lg sm:text-xl group-hover:underline flex items-center gap-2">
            <span>📑</span>
            <span>2026年全网28家精选机场资料全汇总长文</span>
          </h3>
          <p class="text-xs sm:text-sm text-blue-100 mt-1">
            点击可开启：包含全部 28 家机场价格对比、原生IP解锁、节点地区与官网入口的完整指南。
          </p>
        </div>
        <span
          class="px-6 py-3 bg-white text-blue-700 font-black rounded-xl text-xs sm:text-sm shadow-md group-hover:bg-blue-50 group-hover:scale-105 transition-all whitespace-nowrap shrink-0"
        >
          阅读全汇总长篇大文章 →
        </span>
      </div>
    </a>

    <!-- Grid of all 28 provider cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {providersData.map(p => (
        <ProviderCard
          rank={p.rank}
          name={p.name}
          slug={p.slug}
          inviteURL={p.inviteURL}
          priceFrom={p.priceFrom}
          trafficFrom={p.trafficFrom}
          coupon={p.coupon}
          suitableFor={p.suitableFor}
          summary={p.summary}
          isPrimary={p.isPrimary}
          regions={p.regions}
          aiUnlock={p.aiUnlock}
          deviceLimit={p.deviceLimit}
          packagesSummary={p.packagesSummary}
        />
      ))}
    </div>
  </div>
</BaseLayout>
